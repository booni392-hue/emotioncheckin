<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>매일 마음 체크인 · 스마트올 (v10)</title>
<style>
  :root{
    --orange:#FF7A00; --orange-d:#F26800; --orange-soft:#FFF3E8; --orange-brd:#FFD3AC;
    --bg:#EAF0FB; --panel:#FFFFFF; --ink:#2B2F38; --sub:#8B94A7;
    --line:#E7ECF5; --line2:#D9E1F0;
    --a:#FF8A3D; --b:#4C8DFF; --c:#7C6BFF; --d:#FFC02E;
    --radius:22px; --shadow:0 10px 30px rgba(60,80,140,.10);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;height:100%}
  body{
    font-family:"Malgun Gothic","Apple SD Gothic Neo","Pretendard",system-ui,sans-serif;
    background:#c9d4ea;color:var(--ink);
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    min-height:100vh;padding:14px 16px 18px;gap:10px;
  }
  .tab{
    width:100%;max-width:1280px;aspect-ratio:16/10;max-height:calc(100vh - 96px);
    background:var(--bg);border-radius:26px;position:relative;overflow:hidden;
    box-shadow:0 24px 70px rgba(30,50,110,.28);display:flex;flex-direction:column;
  }

  /* top bar (no progress bar) */
  .top{height:70px;display:flex;align-items:center;gap:14px;padding:0 30px;flex:none}
  .close{font-size:24px;color:var(--sub);background:none;border:none;cursor:pointer;line-height:1}
  .logo{display:flex;align-items:baseline;gap:1px;font-weight:900;font-size:22px;letter-spacing:-.5px;user-select:none}
  .logo .s{color:#3A4051}.logo .a{color:var(--orange)}
  .logo .tag{font-size:12px;font-weight:700;color:var(--sub);margin-left:8px}
  .snd{margin-left:auto;background:#fff;border:1px solid var(--line);border-radius:999px;
       width:38px;height:38px;font-size:17px;cursor:pointer;font-family:inherit;line-height:1;
       display:flex;align-items:center;justify-content:center;transition:.15s;padding:0}
  .snd:hover{background:#F4F7FC;transform:scale(1.06)}
  .snd.off{opacity:.45}
  .streak{margin-left:10px;font-size:13px;color:#5A6274;background:#fff;border:1px solid var(--line);
          padding:8px 15px;border-radius:999px;font-weight:800}
  .dots{display:flex;gap:6px;margin-left:14px}
  .dots i{width:8px;height:8px;border-radius:50%;background:#D3DBEC;transition:.2s}
  .dots i.on{background:var(--orange);transform:scale(1.15)}

  /* stage */
  .stage{flex:1;display:grid;grid-template-columns:minmax(0,0.92fr) minmax(0,1.08fr);gap:36px;padding:8px 44px 22px;min-height:0;
         max-width:1200px;margin:0 auto;width:100%}
  .left{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;
        padding:6px 18px;min-width:0}
  .mascot{width:160px;height:160px;border-radius:40px;display:flex;align-items:center;justify-content:center;
          font-size:90px;background:radial-gradient(circle at 40% 34%,#FFE6C4,#FFB25E);
          box-shadow:0 18px 44px rgba(255,150,60,.5), 0 0 0 8px rgba(255,180,90,.14);
          margin-bottom:24px;position:relative;animation:mascotFloat 3s infinite ease-in-out}
  .mascot::after{content:"";position:absolute;inset:-14px;border-radius:48px;
          background:radial-gradient(circle,rgba(255,160,60,.22),transparent 68%);z-index:-1}
  @keyframes mascotFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
  .q-eyebrow{font-size:15px;font-weight:900;color:var(--orange);letter-spacing:.4px;margin-bottom:16px}
  /* big title = the greeting/question, 문장 단위 줄바꿈 */
  .q-title{font-size:31px;font-weight:900;line-height:1.5;letter-spacing:-.7px;margin:0;color:#252A34;
           word-break:keep-all;max-width:100%}
  @media (max-width:1250px), (max-height:830px){ .q-title{font-size:27px} }
  @media (max-width:1150px), (max-height:730px){ .q-title{font-size:24px} }
  .q-title .nm{color:var(--orange)}
  .q-title br{content:"";display:block}

  .right{display:flex;flex-direction:column;justify-content:center;min-height:0;min-width:0;position:relative;
         max-width:640px;margin:0 auto;width:100%}
  .right-guide{font-size:18px;font-weight:800;color:#7A8296;line-height:1.55;margin-bottom:20px;padding-left:4px;text-align:center}
  .right-guide b{color:var(--orange-d)}
  /* 초등 저학년용: 한 줄에 하나씩, 크고 시원하게 */
  .opts{display:grid;grid-template-columns:1fr;gap:15px}
  .opts.one{grid-template-columns:1fr}
  .opt{position:relative;display:flex;align-items:center;gap:20px;background:#fff;border:3px solid var(--line);
       border-radius:22px;padding:16px 28px;cursor:pointer;font-size:30px;font-weight:800;
       transition:transform .16s,border-color .16s,background .16s,box-shadow .16s;
       box-shadow:0 3px 12px rgba(60,80,140,.06);text-align:left;color:var(--ink);min-height:90px}
  .opt .radio{width:32px;height:32px;border-radius:50%;border:3px solid var(--line2);flex:none;
       display:flex;align-items:center;justify-content:center;transition:.16s}
  .opt .emoji{font-size:50px;margin-left:auto;transition:.2s;flex:none;line-height:1}
  .opt .otext{flex:1;word-break:keep-all;line-height:1.35}
  .opt:hover{border-color:#FFCB99;transform:translateY(-2px)}
  .opt.sel{border-color:var(--orange);background:var(--orange-soft);
           box-shadow:0 10px 26px rgba(255,122,0,.25);transform:translateY(-3px) scale(1.02);z-index:2}
  .opt.sel .radio{border-color:var(--orange);background:var(--orange)}
  .opt.sel .radio::after{content:"";width:14px;height:14px;background:#fff;border-radius:50%}
  .opt.sel .emoji{transform:scale(1.4) rotate(-6deg)}
  .opt.dim{opacity:.5;filter:saturate(.6)}

  /* 목업이 작게 렌더될 때 보기 크기 비례 축소 (.opt 정의 뒤에 와야 적용됨) */
  @media (max-width:1250px), (max-height:830px){
    .right-guide{font-size:16px;margin-bottom:15px}
    .opts{gap:12px}
    .opt{font-size:25px;padding:12px 22px;min-height:74px;gap:16px;border-radius:19px}
    .opt .radio{width:28px;height:28px}
    .opt .emoji{font-size:42px}
    .opt.sel .radio::after{width:12px;height:12px}
  }
  @media (max-width:1250px), (max-height:830px){
    .fb{padding:9px 16px;border-radius:15px;gap:10px}
    .fb .fx{font-size:25px}
    .fb .txt{font-size:14.5px}
  }
  @media (max-width:1150px), (max-height:730px){
    .right-guide{font-size:14.5px;margin-bottom:12px}
    .opts{gap:10px}
    .opt{font-size:22px;padding:10px 18px;min-height:62px;gap:13px;border-radius:16px}
    .opt .radio{width:24px;height:24px}
    .opt .emoji{font-size:35px}
    .opt.sel .radio::after{width:10px;height:10px}
  }

  /* POP feedback - big, floating, springs out */
  .fbwrap{position:absolute;left:0;right:0;bottom:0;height:0;pointer-events:none}
  .fb{position:absolute;left:50%;bottom:0;transform:translate(-50%,20px) scale(.6);
      background:linear-gradient(120deg,#FFFFFF,#FFF4EA);border:2px solid var(--orange-brd);
      border-radius:18px;padding:12px 20px;display:flex;align-items:center;gap:12px;
      box-shadow:0 18px 44px rgba(255,120,0,.32);opacity:0;pointer-events:none;
      transition:transform .4s cubic-bezier(.2,1.5,.4,1),opacity .28s;white-space:nowrap;z-index:6}
  .fb.show{opacity:1;transform:translate(-50%,0) scale(1)}
  .fb .fx{font-size:30px;animation:pop-bounce .6s ease;line-height:1}
  .fb .txt{font-size:16.5px;font-weight:900;color:#8A4A18;line-height:1.35}
  .fb .txt b{color:var(--orange-d)}
  @keyframes pop-bounce{0%{transform:scale(.3) rotate(-20deg)}55%{transform:scale(1.35) rotate(10deg)}100%{transform:scale(1) rotate(0)}}
  /* confetti dots */
  .spark{position:absolute;width:9px;height:9px;border-radius:2px;opacity:0}
  .fb.show .spark{animation:fly .7s ease forwards}
  @keyframes fly{0%{opacity:1;transform:translate(0,0) scale(1)}100%{opacity:0;transform:var(--to) scale(.3)}}

  /* ===== 시작 화면 (스마트올 홈) — 원본 이미지 속 봇 활용 ===== */
  .home{position:absolute;inset:0;z-index:50;background:#FCE8B8;overflow:hidden}
  .home img{width:100%;height:100%;object-fit:fill;display:block}
  /* 원본 봇(좌하단, 이미지 안) 옆에 붙는 말풍선. 봇 실제 위치 기준으로 배치 */
  .home .speech{position:absolute;left:9.5%;bottom:9%;background:#fff;border-radius:18px 18px 18px 6px;
        padding:15px 20px;box-shadow:0 12px 30px rgba(40,80,160,.28);max-width:300px;cursor:pointer;
        animation:speechPop .5s cubic-bezier(.3,1.4,.5,1) both, speechFloat 2.6s 0.5s infinite ease-in-out}
  @keyframes speechPop{from{opacity:0;transform:translateY(14px) scale(.8)}to{opacity:1;transform:none}}
  @keyframes speechFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
  .home .speech .t1{font-size:18px;font-weight:900;color:#2B2F38;line-height:1.45}
  .home .speech .t2{font-size:13px;font-weight:800;color:#5B93FF;margin-top:7px}
  .home .speech::after{content:"";position:absolute;left:-9px;bottom:12px;width:0;height:0;
        border:9px solid transparent;border-right-color:#fff;border-left:0}
  /* 원본 봇 위에 얹는 투명 터치 영역 + 시선 유도 링 */
  .home .bot-hit{position:absolute;left:0.8%;bottom:2%;width:110px;height:110px;border-radius:50%;
        background:transparent;border:none;cursor:pointer;padding:0}
  .home .bot-hit::after{content:"";position:absolute;inset:6px;border-radius:50%;
        box-shadow:0 0 0 0 rgba(90,180,255,.55);animation:ring 1.7s infinite}
  @keyframes ring{0%{box-shadow:0 0 0 0 rgba(90,180,255,.5)}70%{box-shadow:0 0 0 20px rgba(90,180,255,0)}100%{box-shadow:0 0 0 0 rgba(90,180,255,0)}}


  .dmap{display:none;flex-direction:column;height:100%;padding:2px;grid-column:1 / -1}
  .dmap.show{display:flex;animation:fadeUp .45s ease}
  .dmap-head{flex:none;padding:0 4px 10px}
  .dmap-head h2{font-size:26px;font-weight:900;margin:0 0 6px}
  .dmap-head p{color:#6D7688;font-size:15px;font-weight:700;line-height:1.5;margin:0}
  .dmap-head b{color:var(--orange)}
  .path-scroll{flex:1;overflow-x:auto;overflow-y:hidden;border-radius:22px;
       background:linear-gradient(160deg,#EAF1FF,#F3EEFF);border:1px solid var(--line);
       box-shadow:inset 0 2px 12px rgba(80,90,160,.06);position:relative;padding:10px 0}
  .path-scroll::-webkit-scrollbar{height:10px}
  .path-scroll::-webkit-scrollbar-thumb{background:#C9D3EC;border-radius:999px}
  .path-scroll::-webkit-scrollbar-track{background:transparent}
  .path-inner{position:relative;height:320px}
  .path-svg{position:absolute;left:0;top:0}
  .track-line{fill:none;stroke:#D7DFF2;stroke-width:14;stroke-linecap:round;stroke-dasharray:2 22}
  .prog-line{fill:none;stroke:url(#g) ;stroke:#FFB45E;stroke-width:14;stroke-linecap:round;
       filter:drop-shadow(0 4px 8px rgba(255,150,60,.35))}
  .node{position:absolute;transform:translate(-50%,-50%);text-align:center;
        animation:nodePop .5s cubic-bezier(.3,1.5,.5,1) both}
  @keyframes nodePop{from{opacity:0;transform:translate(-50%,-30%) scale(.4)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
  .node .bubble{width:74px;height:74px;border-radius:50%;display:flex;align-items:center;justify-content:center;
        font-size:36px;margin:0 auto;position:relative;transition:.2s}
  .node.done .bubble{background:radial-gradient(circle at 40% 35%,#FFE7C2,#FF9E45);
        box-shadow:0 8px 20px rgba(255,150,60,.45),0 0 0 5px #fff}
  .node.today .bubble{background:radial-gradient(circle at 40% 35%,#8FB4FF,#4C8DFF);
        box-shadow:0 8px 22px rgba(76,141,255,.5),0 0 0 5px #fff;animation:todayPulse 1.4s infinite}
  @keyframes todayPulse{0%,100%{box-shadow:0 8px 22px rgba(76,141,255,.5),0 0 0 5px #fff}
        50%{box-shadow:0 10px 28px rgba(76,141,255,.7),0 0 0 9px rgba(76,141,255,.18)}}
  .node.locked .bubble{background:#E4E9F5;box-shadow:inset 0 3px 8px rgba(120,130,170,.2);
        font-size:28px;opacity:.85}
  .node .dlabel{margin-top:8px;font-size:13px;font-weight:800;color:#4A5266;white-space:nowrap;max-width:110px}
  .node.locked .dlabel{color:#A9B2C6}
  .node .dnum{font-size:11px;font-weight:800;color:#AEB7CC;margin-top:2px}
  .node.today .dlabel{color:#2E6BE0}
  .goal{position:absolute;transform:translate(-50%,-50%);text-align:center;font-size:40px;
        animation:nodePop .5s ease both}
  .goal span{display:block;font-size:12px;font-weight:900;color:#C79200;margin-top:2px;white-space:nowrap}
  .legend{flex:none;display:flex;gap:20px;justify-content:center;padding:12px 0 2px;
        font-size:13px;font-weight:800;color:#6D7688}
  .legend i.lg{display:inline-block;width:14px;height:14px;border-radius:50%;vertical-align:-2px;margin-right:5px}
  .legend i.done{background:#FF9E45}.legend i.today{background:#4C8DFF}.legend i.locked{background:#D6DCEA}

  /* Day 노드 탭 가능 표시 */
  .node.tapable{cursor:pointer}
  .node.tapable .bubble{transition:transform .18s, box-shadow .18s}
  .node.tapable:hover .bubble{transform:translateY(-5px) scale(1.16);
        filter:drop-shadow(0 10px 14px rgba(60,90,160,.35))}
  .node .dpeek{margin-top:3px;font-size:10.5px;font-weight:800;color:#A6B0C6;
        opacity:0;transition:.18s;white-space:nowrap}
  .node.tapable:hover .dpeek{opacity:1}

  /* ===== Day 상세 모달 ===== */
  .dmodal{position:absolute;inset:0;z-index:70;background:rgba(24,36,72,.5);
        display:flex;align-items:center;justify-content:center;padding:34px;
        backdrop-filter:blur(3px);animation:fadeUp .22s ease}
  .dm-card{position:relative;background:#fff;border-radius:26px;padding:26px 28px 24px;
        width:100%;max-width:600px;max-height:84%;overflow-y:auto;
        box-shadow:0 26px 70px rgba(15,30,80,.4);animation:cardPop .32s cubic-bezier(.2,1.2,.4,1) both}
  .dm-x{position:absolute;top:16px;right:18px;background:#F2F5FB;border:none;border-radius:50%;
        width:34px;height:34px;font-size:16px;color:#7A8296;cursor:pointer;font-family:inherit;font-weight:900}
  .dm-x:hover{background:#E6EBF6}
  .dm-head{display:flex;align-items:center;gap:14px;margin-bottom:18px;padding-right:40px}
  .dm-emoji{width:56px;height:56px;border-radius:18px;display:flex;align-items:center;
        justify-content:center;font-size:30px;flex:none}
  .dm-title{font-size:21px;font-weight:900;color:#2B2F38;line-height:1.3}
  .dm-sub{font-size:13px;font-weight:800;color:#8B94A7;margin-top:3px}
  .dm-item{border:1.5px solid var(--line);border-radius:18px;padding:15px 17px;margin-bottom:11px;
        background:#FAFBFF}
  .dm-item:last-child{margin-bottom:0}
  .dm-qn{font-size:12px;font-weight:900;color:#A6B0C6;margin-bottom:7px;display:flex;
        align-items:center;gap:8px}
  .dm-tag{font-size:11.5px;font-weight:900;padding:3px 9px;border-radius:999px}
  .dm-q{font-size:16px;font-weight:800;color:#5A6274;line-height:1.55;margin-bottom:11px;word-break:keep-all}
  .dm-a{display:flex;align-items:center;gap:9px;font-size:19px;font-weight:900;word-break:keep-all}
  .dm-a .ae{font-size:25px}
  .dm-note{font-size:16px;font-weight:800;color:#7A8296;line-height:1.7;text-align:center;
        padding:16px 6px;background:#F7F9FD;border-radius:16px}

  /* ===== 다른 친구들의 마음지도 ===== */
  .friends{flex:none;padding:14px 4px 2px;margin-top:6px;border-top:1.5px dashed #D8E0F0}
  .friends-title{font-size:16px;font-weight:900;color:#3A4051;margin-bottom:12px}
  .friends-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .friend-card{background:#fff;border:1.5px solid var(--line);border-radius:18px;padding:14px 16px;
        cursor:pointer;text-align:left;transition:.16s;box-shadow:0 2px 10px rgba(60,80,140,.05);font-family:inherit}
  .friend-card:hover{transform:translateY(-3px);border-color:#C7D3EC;box-shadow:0 10px 24px rgba(60,80,140,.14)}
  .fc-top{display:flex;align-items:center;gap:8px;margin-bottom:10px}
  .fc-emoji{font-size:26px}
  .fc-name{font-size:16px;font-weight:900;color:#2B2F38}
  .fc-prog{margin-left:auto;font-size:12px;font-weight:800;color:#8B94A7;background:#F1F5FC;padding:4px 9px;border-radius:999px}
  .fc-mini{display:flex;gap:3px;flex-wrap:wrap;margin-bottom:10px}
  .fc-mini .mini{width:20px;height:20px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:13px}
  .fc-mini .mini.on{background:#FFF1E4}
  .fc-mini .mini.off{background:#EEF2F9;color:#C2CAD9}
  .fc-cta{font-size:13px;font-weight:900;color:var(--orange)}

  /* 친구 지도 뷰(분위기 전환) */
  .friend-view{--fbg:#eef;--ftrack:#ccd;--fprog:#88f;--faccent:#66a}
  .backbtn{background:#fff;border:1.5px solid var(--line2);color:#5A6274;border-radius:999px;
        padding:8px 16px;font-size:14px;font-weight:800;cursor:pointer;font-family:inherit;margin-bottom:10px;transition:.15s}
  .backbtn:hover{background:#F3F6FC;transform:translateX(-2px)}
  .backbtn.big{padding:14px 30px;font-size:16px;box-shadow:0 6px 16px rgba(80,100,160,.14)}
  .friend-scroll{border-width:1.5px;border-style:solid}
  .friend-foot{flex:none;display:flex;justify-content:center;padding:14px 0 2px}


  .map{display:none;height:100%;padding:6px}
  .map.show{display:flex;gap:26px;align-items:center;animation:fadeUp .45s ease}
  @keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .sky{flex:1;align-self:stretch;background:linear-gradient(160deg,#5B7BE6,#8A6BF0);border-radius:24px;
       padding:36px;color:#fff;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden;
       box-shadow:0 16px 40px rgba(90,90,200,.35)}
  .sky h3{font-size:26px;font-weight:900;margin:0 0 20px}
  .starwrap{display:flex;flex-wrap:wrap;gap:16px;margin-bottom:22px}
  .star{font-size:38px;animation:tw 2s infinite ease-in-out}
  .star:nth-child(2n){animation-delay:.5s}.star:nth-child(3n){animation-delay:1s}
  @keyframes tw{0%,100%{opacity:.55;transform:scale(.9)}50%{opacity:1;transform:scale(1.18)}}
  .sky .note{font-size:16px;color:#EAE4FF;font-weight:700;line-height:1.6}
  .mapside{width:320px}
  .mapside h2{font-size:27px;font-weight:900;margin:0 0 12px}
  .mapside p{color:#6D7688;font-size:15px;font-weight:700;line-height:1.6;margin:0 0 22px}
  .chips{display:flex;flex-direction:column;gap:11px}
  .chip{background:#fff;border:1px solid var(--line);border-radius:14px;padding:13px 17px;
        font-size:16px;font-weight:800;color:#555;display:flex;justify-content:space-between}
  .chip b{color:var(--orange)}

  /* result */
  /* ===== Day10 성향 결과: 특별 전체화면 ===== */
  .result-screen{--k:1;position:absolute;inset:0;z-index:40;display:flex;flex-direction:column;
        overflow:hidden;animation:resIn .55s cubic-bezier(.2,1,.3,1)}
  @keyframes resIn{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:none}}
  .cfetti-wrap{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:1}
  .cfetti{position:absolute;top:-20px;width:11px;height:14px;border-radius:2px;opacity:.9;
        animation:cfall linear infinite}
  @keyframes cfall{0%{transform:translateY(-30px) rotate(0)}100%{transform:translateY(760px) rotate(540deg)}}
  .rs-inner{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;
        padding:calc(20px * var(--k)) calc(48px * var(--k)) 6px;min-height:0;overflow-y:auto}

  /* ===== 상단 대형 타이틀 ===== */
  .rs-eyebrow{text-align:center;color:#fff;display:flex;flex-direction:column;align-items:center;
        gap:calc(2px * var(--k));margin-bottom:calc(14px * var(--k));animation:heroIn .6s cubic-bezier(.2,1.2,.4,1) both}
  @keyframes heroIn{from{opacity:0;transform:translateY(-16px) scale(.9)}to{opacity:1;transform:none}}
